# Copy to .env and fill in. .env is gitignored; never commit real values.
# The same names are the GitLab CI/CD variables (masked + protected), see https://gitlab.com/libreusos/LibreUSOS/-/wikis/Releasing.

# USOS consumer key per university: USOS_<UNI>_CONSUMER_KEY / _SECRET. Only PolSl is built for now.
USOS_POLSL_CONSUMER_KEY=
USOS_POLSL_CONSUMER_SECRET=

# Android release signing. In CI the keystore is the Secure File libreusos-release.jks;
# locally it is the gitignored copy in the repo root.
LIBREUSOS_KEYSTORE=libreusos-release.jks
LIBREUSOS_KEYSTORE_PASSWORD=
LIBREUSOS_KEY_ALIAS=libreusos
